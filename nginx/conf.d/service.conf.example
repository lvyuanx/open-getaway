# Copy this file to nginx/conf.d/<service-name>.conf and update the values.
# Files ending in .example are not loaded by Nginx.
#
# Requirements for the target project:
# - The service is attached to the external Docker network named
#   open-getaway-network.
# - <service-name> is the Compose service name on that network.
# - <container-port> is the port listened to inside the target container.
# - The target process listens on 0.0.0.0, not only on 127.0.0.1.
# - No host port mapping is required for gateway-to-service traffic.
# - Every service uses a unique server_name.

server {
    listen 80;
    server_name service.example.com;

    location / {
        # The variable form makes Docker DNS resolve at request time. This
        # allows the target container to start after the gateway and to be
        # recreated with a new IP without restarting the gateway.
        set $service_upstream http://<service-name>:<container-port>;
        proxy_pass $service_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep these headers when the service uses WebSocket or another
        # connection-upgrade protocol. The map is defined in nginx.conf.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Path-based routing example:
#
# location /orders/ {
#     set $order_upstream http://order-api:8080;
#     rewrite ^/orders/(.*)$ /$1 break;
#     proxy_pass $order_upstream;
# }
#
# The rewrite above makes /orders/users become /users while retaining dynamic
# Docker DNS resolution. If the service is guaranteed to exist when Nginx
# starts, the equivalent static forms are:
#
# location /orders/ {
#     # With the trailing slash, /orders/users becomes /users.
#     proxy_pass http://order-api:8080/;
# }
#
# location /orders/ {
#     # Without the trailing slash, Nginx forwards the original URI.
#     proxy_pass http://order-api:8080;
# }
#
# Static files and SPA history fallback should be configured by the frontend
# container. The gateway only forwards the request to that container.

